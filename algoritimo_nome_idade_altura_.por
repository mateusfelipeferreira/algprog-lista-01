programa {
  funcao inicio() {
    cadeia nome
    inteiro idade
    real altura
    escreva("escreva seu nome: \n")
    leia(nome)
    escreva("escreva aqui sua idade: \n")
    leia(idade)
    escreva("escreva aqui sua altura: \n")
    leia(altura)

escreva("\n nome:", nome )
  escreva("\n idade:", idade)
  escreva("\n altura", altura)
    
  }
}
